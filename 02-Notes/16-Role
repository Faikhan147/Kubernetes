What is Role ?

It define permissions like Read, Write, Execute

Example: role.yaml--> Granting Read, Write, Execute Resources

apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: full-control
  namespace: default
rules:
  # Read + Write
  - apiGroups: ["", "apps", "batch", "networking.k8s.io"]
    resources: ["pods", "services", "configmaps", "secrets", "persistentvolumeclaims", "deployments", "replicasets", "statefulsets", "ingresses", "jobs", "cronjobs"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]

  # Exec permission for kubectl exec
  - apiGroups: [""]
    resources: [ pods/exec ]
    verbs: ["create"]

